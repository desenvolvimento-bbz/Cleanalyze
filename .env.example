# ============================================================================
# Cleanalyze — Variaveis de ambiente
# Copie este arquivo para `.env` e preencha com os valores reais.
# O arquivo `.env` NAO deve ser commitado no Git.
# ============================================================================

# --- Google OAuth ---
# Obtido em https://console.cloud.google.com/ > APIs & Services > Credentials
GOOGLE_CLIENT_ID=

# --- Mistral (OCR) ---
# Obtido em https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# --- OpenAI (embeddings + chat) ---
# Obtido em https://platform.openai.com/api-keys
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-4o-mini

# --- Parametros do RAG ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
